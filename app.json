{
  "expo": {
    "name": "BuildThread",
    "slug": "buildthread-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buildthreadapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.buildthread.app",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "android": {
      "package": "com.buildthread.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BuildThread to use your camera to capture project evidence.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BuildThread to choose a company logo. Quick Log can also import a photo, which is marked unverified. Compliance evidence is taken with the camera.",
          "cameraPermission": "Allow BuildThread to use your camera to capture project evidence.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BuildThread to use your location to tag project evidence."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "compliance-reminders",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow BuildThread to use the microphone to dictate photo notes.",
          "speechRecognitionPermission": "Allow BuildThread to turn speech into photo notes."
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://buildthread.app/privacy"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
