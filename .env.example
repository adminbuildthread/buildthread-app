# Firebase web app config.
# Copy this file to .env.local and paste the values from
# Firebase console → Project settings → Your apps → SDK setup and configuration.
# Never commit .env.local or real keys. These EXPO_PUBLIC_ values are client config,
# not server secrets, but they still should not be invented or checked in.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Leave blank to use the (default) database.
# Set this only when the database ID is not (default).
EXPO_PUBLIC_FIREBASE_DATABASE_ID=

# Optional. Overrides the privacy policy URL in app.json extra.
# Use a real hosted page before store submission. The placeholder is not a live policy.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://buildthread.app/privacy
